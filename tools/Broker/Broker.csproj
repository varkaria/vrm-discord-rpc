<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>VrmPresence</AssemblyName>
    <LangVersion>9</LangVersion>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <PathMap>$(MSBuildProjectDirectory)/../../=/_/</PathMap>
    <DefineConstants Condition="'$(BrokerTest)' == 'true'">BROKER_TEST</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Packages/dev.varkaria.discordrpc/Editor/PresenceController.cs" Link="PresenceController.cs" />
    <Compile Include="../../Packages/dev.varkaria.discordrpc/Editor/BrokerProtocol.cs" Link="BrokerProtocol.cs" />
    <Reference Include="DiscordRPC"><HintPath>../../Packages/dev.varkaria.discordrpc/Editor/ThirdParty/DiscordRPC.dll</HintPath></Reference>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
</Project>
